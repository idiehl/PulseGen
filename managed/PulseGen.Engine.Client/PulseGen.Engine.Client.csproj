<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Managed client for the versioned PulseGen.Engine C ABI.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PulseGen.Contracts\PulseGen.Contracts.csproj" />
    <InternalsVisibleTo Include="PulseGen" />
    <InternalsVisibleTo Include="PulseGen.Engine.Client.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <PulseGenSampleCodecPath>$(MSBuildProjectDirectory)\..\..\.runtime\codecs\libsndfile-1.2.2\sndfile.dll</PulseGenSampleCodecPath>
  </PropertyGroup>
  <Target Name="RequirePulseGenSampleCodecRuntime" BeforeTargets="PrepareForBuild" Condition="!Exists('$(PulseGenSampleCodecPath)')">
    <Error Text="The pinned libsndfile runtime is missing. Run scripts/bootstrap-codecs.ps1." />
  </Target>
  <ItemGroup>
    <None Include="$(PulseGenSampleCodecPath)" Link="sndfile.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
