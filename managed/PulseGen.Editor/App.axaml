<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PulseGen.Editor.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#141A22" />
      <Setter Property="BorderBrush" Value="#263142" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="Foreground" Value="#91A4BD" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="Foreground" Value="#E7EDF5" />
      <Setter Property="FontFamily" Value="Consolas" />
    </Style>
  </Application.Styles>
</Application>
