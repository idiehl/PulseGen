<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PulseGen.Atlas.Client\PulseGen.Atlas.Client.csproj" />
    <ProjectReference Include="..\PulseGen.Contracts\PulseGen.Contracts.csproj" />
    <ProjectReference Include="..\PulseGen.Engine.Client\PulseGen.Engine.Client.csproj" />
    <ProjectReference Include="..\PulseGen.ModelHost.Client\PulseGen.ModelHost.Client.csproj" />
    <ProjectReference Include="..\PulseGen.Workspace\PulseGen.Workspace.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PulseGen.Editor.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <PulseGenSndFilePath>$(MSBuildProjectDirectory)\..\..\.runtime\codecs\libsndfile-1.2.2\sndfile.dll</PulseGenSndFilePath>
  </PropertyGroup>
  <Target Name="RequirePulseGenCodecRuntime" BeforeTargets="PrepareForBuild" Condition="!Exists('$(PulseGenSndFilePath)')">
    <Error Text="The pinned libsndfile runtime is missing. Run scripts/bootstrap-codecs.ps1." />
  </Target>
  <ItemGroup>
    <None Include="$(PulseGenSndFilePath)" Link="sndfile.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
