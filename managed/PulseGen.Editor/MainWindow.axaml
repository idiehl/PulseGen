<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PulseGen.Editor"
        x:Class="PulseGen.Editor.MainWindow"
        Title="PulseGen — Physics-First Audio Workstation"
        Width="1420" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14">
  <Grid RowDefinitions="52,*,230" ColumnDefinitions="270,*,326">
    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#111721" BorderBrush="#273244" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,20,Auto,*,Auto,16,Auto" Margin="14,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="7" Background="#64D8CB">
            <TextBlock Text="∿" Foreground="#071311" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="PULSEGEN" FontWeight="Bold" FontSize="13" Foreground="#ECF7F5" LetterSpacing="1.5" />
            <TextBlock x:Name="SceneNameText" Text="Physics Flyby · scene v1" FontSize="10" Foreground="#8091A7" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <Button x:Name="PlayButton" Content="▶  Preview" Click="OnPlayClicked" />
          <Button Content="■  Stop" Click="OnStopClicked" />
          <Button x:Name="GestureButton" Content="●  Gesture" Click="OnGestureClicked" ToolTip.Tip="Draw a motion path directly in the world; raw motion is retained beside simplified automation." />
          <Button Content="↗  Open" Click="OnOpenClicked" ToolTip.Tip="Open a validated .pulseproj directory without discarding the current scene if loading fails." />
          <Button Content="⌑  Save" Click="OnSaveClicked" ToolTip.Tip="Save the current scene atomically as a .pulseproj directory." />
          <Button x:Name="AnalyzeButton" Content="⌁  Analyze" Click="OnAnalyzeClicked" ToolTip.Tip="Decompose the most recently rendered receiver take into partial, transient, and stochastic layers." />
          <Button Content="⇥  Render" Background="#266A64" Foreground="White" Click="OnRenderClicked" ToolTip.Tip="Render an isolated two-channel WAV take for each enabled receiver rig." />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <TextBlock Text="48 kHz" Foreground="#B8C4D3" VerticalAlignment="Center" />
          <Border Background="#152E28" CornerRadius="9" Padding="8,3">
            <TextBlock Text="ENGINE READY" Foreground="#73E6C2" FontSize="10" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="6" Text="0.1.0-alpha" Foreground="#64758B" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#10151D" BorderBrush="#253042" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Margin="14,13,14,8" ColumnDefinitions="*,Auto">
          <TextBlock Classes="sectionTitle" Text="SCENE WORLD" />
          <Button x:Name="AddEntityButton" Grid.Column="1" Content="＋" Width="28" Height="25" Padding="0" ToolTip.Tip="Add a room, acoustic surface, wind zone, or atmosphere layer">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Reflective plane" Click="OnAddPlaneClicked" />
                <MenuItem Header="Acoustic box" Click="OnAddBoxClicked" />
                <MenuItem Header="Parametric room" Click="OnAddRoomClicked" />
                <MenuItem Header="Bounded wind zone" Click="OnAddWindZoneClicked" />
                <MenuItem Header="Atmosphere layer" Click="OnAddAtmosphereLayerClicked" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <TreeView x:Name="SceneTree" Grid.Row="1" Margin="7,0" Background="Transparent" SelectionChanged="OnSceneTreeSelectionChanged" />
        <Border Grid.Row="2" Classes="panel" Margin="10" Padding="11">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="SIMULATION SUMMARY" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Text="World units" Foreground="#8292A6" /><TextBlock Grid.Column="1" Classes="value" Text="SI / metres" />
              <TextBlock Grid.Row="1" Text="Emitters" Foreground="#8292A6" /><TextBlock x:Name="EmitterCountText" Grid.Row="1" Grid.Column="1" Classes="value" Text="1 mono" />
              <TextBlock Grid.Row="2" Text="Receiver takes" Foreground="#8292A6" /><TextBlock x:Name="ReceiverCountText" Grid.Row="2" Grid.Column="1" Classes="value" Text="2 stereo" />
              <TextBlock Grid.Row="3" Text="Duration" Foreground="#8292A6" /><TextBlock x:Name="DurationSummaryText" Grid.Row="3" Grid.Column="1" Classes="value" Text="6.000 s" />
            </Grid>
            <Border Height="1" Background="#2B3748" Margin="0,3" />
            <TextBlock x:Name="AtlasStateText" Classes="sectionTitle" Text="PRIVATE · LOCAL ONLY" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <Button x:Name="AtlasButton" Content="◇  Atlas sign in" Click="OnAtlasClicked" ToolTip.Tip="Use authorization code + PKCE. The rotating refresh token is stored in Windows Credential Manager." />
              <Button x:Name="SyncButton" Grid.Column="1" Content="⇧  Sync project" Click="OnSyncClicked" ToolTip.Tip="Explicitly upload the saved manifest and create an immutable Atlas project revision. Conflicts become named branches." />
            </Grid>
            <Button x:Name="ImportMeshButton" Content="▱  Import acoustic mesh" Click="OnImportMeshClicked" ToolTip.Tip="Copy an OBJ or self-contained glTF/GLB into this project's SHA-256 asset store and add it as a direct-occlusion surface." />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Background="#090D12">
      <local:WorldViewport x:Name="Viewport" />
      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="#C60E141D" BorderBrush="#314052" BorderThickness="1" CornerRadius="6" Padding="10,7">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="PERSPECTIVE" Foreground="#AFC0D2" FontSize="10" />
          <TextBlock Text="Y ↑" Foreground="#66DCCF" FontSize="10" />
          <TextBlock Text="GRID 1 m" Foreground="#718198" FontSize="10" />
        </StackPanel>
      </Border>
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Background="#D00D131B" CornerRadius="6" Padding="11,8">
        <StackPanel>
          <TextBlock x:Name="PositionText" Text="t  0.000 s" Classes="value" FontSize="12" />
          <TextBlock Text="Drag the time ruler or use Preview" Foreground="#718198" FontSize="10" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Grid.Column="2" Background="#10151D" BorderBrush="#253042" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="10">
          <Grid ColumnDefinitions="*,Auto" Margin="3,1,0,2">
            <StackPanel>
              <TextBlock Classes="sectionTitle" Text="PHYSICS INSPECTOR" />
              <TextBlock x:Name="InspectorSelectionText" Text="440 Hz moving primitive" Foreground="#E9F3F4" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#172631" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
              <TextBlock x:Name="InspectorKindBadge" Text="SOURCE" Foreground="#77DCD1" FontSize="9" FontWeight="SemiBold" />
            </Border>
          </Grid>

          <StackPanel x:Name="EmitterInspectorPanel" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock x:Name="EmitterNameText" Text="440 Hz moving primitive" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Primitive" Foreground="#8192A7" />
                  <ComboBox x:Name="WaveformBox" Grid.Column="1" SelectionChanged="OnWaveformChanged" />
                  <TextBlock Grid.Row="1" Text="Frequency (Hz)" Foreground="#8192A7" /><TextBox x:Name="FrequencyBox" Grid.Row="1" Grid.Column="1" Text="440" HorizontalContentAlignment="Right" LostFocus="OnSignalValueCommitted" />
                  <TextBlock Grid.Row="2" Text="Linear gain" Foreground="#8192A7" /><TextBox x:Name="GainBox" Grid.Row="2" Grid.Column="1" Text="0.800" HorizontalContentAlignment="Right" LostFocus="OnSignalValueCommitted" />
                  <TextBlock Grid.Row="3" Text="Emitter mode" Foreground="#8192A7" /><TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="Point / mono" TextAlignment="Right" />
                  <TextBlock Grid.Row="4" Text="Propagation" Foreground="#8192A7" /><TextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="Retarded" TextAlignment="Right" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionTitle" Text="MOTION AT PLAYHEAD" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                  <TextBlock Text="Position X" Foreground="#8192A7" /><TextBlock x:Name="PositionX" Grid.Column="1" Classes="value" Text="−28.000 m" />
                  <TextBlock Grid.Row="1" Text="Position Y" Foreground="#8192A7" /><TextBlock x:Name="PositionY" Grid.Row="1" Grid.Column="1" Classes="value" Text="1.700 m" />
                  <TextBlock Grid.Row="2" Text="Position Z" Foreground="#8192A7" /><TextBlock x:Name="PositionZ" Grid.Row="2" Grid.Column="1" Classes="value" Text="4.000 m" />
                  <TextBlock Grid.Row="3" Text="Radial velocity" Foreground="#8192A7" /><TextBlock x:Name="VelocityText" Grid.Row="3" Grid.Column="1" Classes="value" Text="9.73 m/s" />
                </Grid>
                <Border Height="1" Background="#293444" Margin="0,4" />
                <TextBlock x:Name="SelectedPointText" Text="KEYFRAME 1 · t 0.000 s" Classes="sectionTitle" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" Foreground="#8192A7" VerticalAlignment="Center" />
                  <TextBox x:Name="KeyframeX" Grid.Column="1" Text="-28.000" LostFocus="OnKeyframeValueCommitted" />
                  <TextBlock Grid.Column="2" Text="Y" Foreground="#8192A7" VerticalAlignment="Center" />
                  <TextBox x:Name="KeyframeY" Grid.Column="3" Text="1.700" LostFocus="OnKeyframeValueCommitted" />
                  <TextBlock Grid.Column="4" Text="Z" Foreground="#8192A7" VerticalAlignment="Center" />
                  <TextBox x:Name="KeyframeZ" Grid.Column="5" Text="4.000" LostFocus="OnKeyframeValueCommitted" />
                </Grid>
                <TextBlock Text="Drag a path point in the world for X/Z; use these fields for exact SI coordinates." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="GeometryInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="GeometryKindText" Text="Reflective plane" Foreground="#E9F3F4" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="SI" Classes="sectionTitle" />
                </Grid>
                <TextBlock Text="Position (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryPositionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryPositionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryPositionZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Authored dimensions (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryDimensionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryDimensionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryDimensionZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Rotation (degrees)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryRotationX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryRotationY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryRotationZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Scale" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryScaleX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryScaleY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryScaleZ" Grid.Column="5" />
                </Grid>
                <Grid ColumnDefinitions="*,130" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Acoustic material" Foreground="#8192A7" VerticalAlignment="Center" />
                  <ComboBox x:Name="GeometryMaterialBox" Grid.Column="1" />
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="GeometryOccludesBox" Content="Blocks sound" />
                    <CheckBox x:Name="GeometryReflectsBox" Content="Creates echoes" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="GeometryConstraintText" Text="Drag the selected centre handle in the world for X/Z movement." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Content="Apply geometry" Background="#266A64" Foreground="White" Click="OnApplyGeometryClicked" />
              <Button Grid.Column="1" Content="Remove" Background="#3A2328" Foreground="#F0B6BC" Click="OnRemoveSelectedClicked" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="WindInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Bounded wind field" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <TextBlock Text="Position (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindPositionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindPositionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindPositionZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Dimensions (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindDimensionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindDimensionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindDimensionZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Rotation (degrees)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindRotationX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindRotationY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindRotationZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Scale" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindScaleX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindScaleY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindScaleZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Velocity (m/s, world axes)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindVelocityX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindVelocityY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindVelocityZ" Grid.Column="5" />
                </Grid>
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Turbulence (0–1)" Foreground="#8192A7" /><TextBox x:Name="WindTurbulence" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Noise seed" Foreground="#8192A7" /><TextBox x:Name="WindNoiseSeed" Grid.Row="1" Grid.Column="1" />
                </Grid>
                <TextBlock Text="Drag the selected centre handle in the world for X/Z movement. The dashed box is the active field boundary." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Content="Apply wind field" Background="#266A64" Foreground="White" Click="OnApplyWindClicked" />
              <Button Grid.Column="1" Content="Remove" Background="#3A2328" Foreground="#F0B6BC" Click="OnRemoveSelectedClicked" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="LayerInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Altitude-bounded air layer" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Bottom altitude (m)" Foreground="#8192A7" /><TextBox x:Name="LayerBaseAltitude" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Top altitude (m)" Foreground="#8192A7" /><TextBox x:Name="LayerTopAltitude" Grid.Row="1" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="Temperature (°C)" Foreground="#8192A7" /><TextBox x:Name="LayerTemperature" Grid.Row="2" Grid.Column="1" />
                  <TextBlock Grid.Row="3" Text="Humidity (%)" Foreground="#8192A7" /><TextBox x:Name="LayerHumidity" Grid.Row="3" Grid.Column="1" />
                  <TextBlock Grid.Row="4" Text="Pressure (kPa)" Foreground="#8192A7" /><TextBox x:Name="LayerPressure" Grid.Row="4" Grid.Column="1" />
                </Grid>
                <TextBlock Text="Layers may have gaps, where base air applies, but they cannot overlap." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Content="Apply air layer" Background="#266A64" Foreground="White" Click="OnApplyLayerClicked" />
              <Button Grid.Column="1" Content="Remove" Background="#3A2328" Foreground="#F0B6BC" Click="OnRemoveSelectedClicked" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="BaseAtmosphereInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Base air outside authored layers" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Temperature (°C)" Foreground="#8192A7" /><TextBox x:Name="BaseTemperature" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Humidity (%)" Foreground="#8192A7" /><TextBox x:Name="BaseHumidity" Grid.Row="1" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="Pressure (kPa)" Foreground="#8192A7" /><TextBox x:Name="BasePressure" Grid.Row="2" Grid.Column="1" />
                </Grid>
                <Button Content="Apply base air" Background="#266A64" Foreground="White" Click="OnApplyBaseAtmosphereClicked" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border x:Name="ReadOnlyInspectorPanel" IsVisible="False" Classes="panel" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock x:Name="ReadOnlySelectionTitle" Text="Selection" Foreground="#E9F3F4" FontWeight="SemiBold" />
              <TextBlock x:Name="ReadOnlySelectionMessage" Text="This object remains visible here while its dedicated controls are developed." TextWrapping="Wrap" Foreground="#8192A7" />
            </StackPanel>
          </Border>

          <Border Classes="panel" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="FIELD SUMMARY" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                <TextBlock Text="Temperature" Foreground="#8192A7" /><TextBlock x:Name="TemperatureText" Grid.Column="1" Classes="value" Text="20.0 °C" />
                <TextBlock Grid.Row="1" Text="Humidity" Foreground="#8192A7" /><TextBlock x:Name="HumidityText" Grid.Row="1" Grid.Column="1" Classes="value" Text="50.0 %" />
                <TextBlock Grid.Row="2" Text="Pressure" Foreground="#8192A7" /><TextBlock x:Name="PressureText" Grid.Row="2" Grid.Column="1" Classes="value" Text="101.325 kPa" />
                <TextBlock Grid.Row="3" Text="Altitude layers" Foreground="#8192A7" /><TextBlock x:Name="LayerCountText" Grid.Row="3" Grid.Column="1" Classes="value" Text="0 · base air" />
                <TextBlock Grid.Row="4" Text="Wind zones" Foreground="#8192A7" /><TextBlock x:Name="WindText" Grid.Row="4" Grid.Column="1" Classes="value" Text="1 bounded · 2.00 m/s" />
                <TextBlock Grid.Row="5" Text="Base sound speed" Foreground="#8192A7" /><TextBlock x:Name="EffectiveSpeedText" Grid.Row="5" Grid.Column="1" Classes="value" Text="344.04 m/s" />
                <TextBlock Grid.Row="6" Text="Preview sampling" Foreground="#8192A7" /><TextBlock x:Name="FieldQualityText" Grid.Row="6" Grid.Column="1" Classes="value" Text="1 / path leg" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Background="#101F20" BorderBrush="#22544E" BorderThickness="1" CornerRadius="6" Padding="11">
            <TextBlock TextWrapping="Wrap" Foreground="#83D8CD" FontSize="11" Text="Preview samples each propagation leg once. Final profiles subdivide every direct and reflected path through authored air and wind fields." />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#0E131B" BorderBrush="#273244" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="36,*">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0">
          <Button Grid.Column="0" Content="SIGNAL GRAPH" Background="Transparent" Foreground="#71DCCF" />
          <Button Grid.Column="1" Content="SPECTRUM" Background="Transparent" Foreground="#8191A6" />
          <Button Grid.Column="2" Content="RECEIVER TAKES" Background="Transparent" Foreground="#8191A6" />
          <TextBlock Grid.Column="4" x:Name="StatusText" Text="Ready · native renderer awaiting command" Foreground="#7D8DA2" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="340,*,330" Margin="10,0,10,10">
          <Border Classes="panel" Padding="12">
            <Canvas Height="175">
              <Border Canvas.Left="8" Canvas.Top="39" Width="108" Height="68" CornerRadius="6" Background="#172931" BorderBrush="#3A8E86" BorderThickness="1" Padding="9">
                <StackPanel><TextBlock x:Name="SignalNodeTitle" Text="SINE" Foreground="#72E0D3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SignalFrequencyText" Text="440.00 Hz" Classes="value" Margin="0,9,0,0"/><TextBlock Text="phase continuous" Foreground="#6F8295" FontSize="9"/></StackPanel>
              </Border>
              <Path Data="M116,73 L193,73" Stroke="#57C8BC" StrokeThickness="2" />
              <Ellipse Canvas.Left="189" Canvas.Top="69" Width="8" Height="8" Fill="#57C8BC" />
              <Border Canvas.Left="197" Canvas.Top="39" Width="112" Height="68" CornerRadius="6" Background="#222331" BorderBrush="#625B86" BorderThickness="1" Padding="9">
                <StackPanel><TextBlock Text="POINT EMITTER" Foreground="#C5BFE8" FontSize="10" FontWeight="Bold"/><TextBlock Text="mono out" Classes="value" Margin="0,9,0,0"/><TextBlock x:Name="SignalGainText" Text="gain 0.800" Foreground="#7D7894" FontSize="9"/></StackPanel>
              </Border>
            </Canvas>
          </Border>
          <Border Grid.Column="1" Classes="panel" Margin="8,0" Padding="12">
            <Grid RowDefinitions="*,22">
              <Canvas ClipToBounds="True">
                <Rectangle Canvas.Left="0" Canvas.Top="52" Width="900" Height="1" Fill="#283647" />
                <Path Data="M0,52 C65,25 125,79 190,52 S315,25 380,52 S505,79 570,52 S695,25 760,52 S840,68 900,52" Stroke="#66DACC" StrokeThickness="2" />
                <Rectangle x:Name="Playhead" Canvas.Left="0" Width="2" Height="145" Fill="#F2B766" />
                <Border Canvas.Left="8" Canvas.Top="104" Width="520" Height="25" Background="#193831" CornerRadius="3" Padding="7,4"><TextBlock x:Name="TimelineSourceText" Text="440 Hz flyby · source active" Foreground="#8FE4D3" FontSize="10"/></Border>
              </Canvas>
              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*">
                <TextBlock x:Name="TimelineTick0" Text="0s" Foreground="#617286"/><TextBlock x:Name="TimelineTick1" Grid.Column="1" Text="1" Foreground="#617286"/><TextBlock x:Name="TimelineTick2" Grid.Column="2" Text="2" Foreground="#617286"/><TextBlock x:Name="TimelineTick3" Grid.Column="3" Text="3" Foreground="#617286"/><TextBlock x:Name="TimelineTick4" Grid.Column="4" Text="4" Foreground="#617286"/><TextBlock x:Name="TimelineTick5" Grid.Column="5" Text="5" Foreground="#617286"/><TextBlock x:Name="TimelineTick6" Grid.Column="6" Text="6s" Foreground="#617286" HorizontalAlignment="Right"/>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="2" Classes="panel" Padding="12">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="ReceiverOneText" Text="Parametric listener" Foreground="#DCE8EE"/><TextBlock Grid.Column="1" Text="L    R" Classes="value" Foreground="#67D9CD"/></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5"><ProgressBar Value="68" Foreground="#4AC7B8"/><ProgressBar Grid.Column="1" Value="57" Foreground="#4AC7B8"/></Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="ReceiverTwoText" Text="ORTF microphone pair" Foreground="#DCE8EE"/><TextBlock Grid.Column="1" Text="L    R" Classes="value" Foreground="#B1A4E2"/></Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="5"><ProgressBar Value="51" Foreground="#8073B6"/><ProgressBar Grid.Column="1" Value="64" Foreground="#8073B6"/></Grid>
              <TextBlock Text="Each rig renders an isolated stereo take." Foreground="#697B90" FontSize="10" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
