<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PulseGen.Editor"
        x:Class="PulseGen.Editor.MainWindow"
        Title="PulseGen — Physics-First Audio Workstation"
        Width="1480" Height="900" MinWidth="1080" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14">
  <Window.Styles>
    <Style Selector="Button.worldTool"><Setter Property="Padding" Value="10,5" /><Setter Property="FontSize" Value="11" /><Setter Property="Background" Value="#19222D" /></Style>
    <Style Selector="Button.worldTool.active"><Setter Property="Background" Value="#24524F" /><Setter Property="Foreground" Value="#A1F3E5" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="52,*,116,1,210" ColumnDefinitions="240,*,306">
    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#111721" BorderBrush="#273244" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,20,Auto,*,Auto,16,Auto" Margin="14,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <Border Width="28" Height="28" CornerRadius="7" Background="#64D8CB">
            <TextBlock Text="∿" Foreground="#071311" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="PULSEGEN" FontWeight="Bold" FontSize="13" Foreground="#ECF7F5" LetterSpacing="1.5" />
            <TextBlock x:Name="SceneNameText" Text="Physics Flyby · scene v1" FontSize="10" Foreground="#8091A7" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <Button Content="↗  Open" Click="OnOpenClicked" ToolTip.Tip="Open a validated .pulseproj directory without discarding the current scene if loading fails." />
          <Button Content="⌑  Save" Click="OnSaveClicked" ToolTip.Tip="Save the current scene atomically as a .pulseproj directory." />
          <Button x:Name="AnalyzeButton" Content="⌁  Analyze" Click="OnAnalyzeClicked" ToolTip.Tip="Decompose the most recently rendered receiver take into partial, transient, and stochastic layers." />
          <Button Content="⇥  Render" Background="#266A64" Foreground="White" Click="OnRenderClicked" ToolTip.Tip="Render an isolated two-channel WAV take for each enabled receiver rig." />
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8" Margin="12,0">
          <TextBlock x:Name="AutosaveStateText" Text="AUTOSAVE STARTING" Foreground="#7F91A7" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="DiscardRecoveryButton" Content="Discard recovery" IsVisible="False" Click="OnDiscardRecoveryClicked" ToolTip.Tip="Reload the last explicitly saved project and leave the recovered snapshot in local history." />
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <TextBlock x:Name="ActiveSampleRateText" Text="48 kHz · INTERACTIVE" Foreground="#B8C4D3" VerticalAlignment="Center" />
          <Border Background="#152E28" CornerRadius="9" Padding="8,3">
            <TextBlock x:Name="EngineStateText" Text="ENGINE READY" Foreground="#73E6C2" FontSize="10" FontWeight="SemiBold" ToolTip.Tip="During preview this shows how much of each hardware audio block PulseGen needs to finish its physics rendering." />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
          <Button Content="?" Width="28" Height="28" Padding="0" Click="OnStartGuideClicked"
                  ToolTip.Tip="Open the plain-language PulseGen start guide."
                  AutomationProperties.Name="Open the PulseGen start guide" />
          <TextBlock Text="0.1.0-alpha.20" Foreground="#64758B" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="#10151D" BorderBrush="#253042" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Margin="14,13,14,8" ColumnDefinitions="*,Auto">
          <TextBlock Classes="sectionTitle" Text="SCENE WORLD" />
          <Button x:Name="AddEntityButton" Grid.Column="1" Content="＋" Width="28" Height="25" Padding="0" ToolTip.Tip="Add an acoustic object, atmosphere field, or stereo receiver rig">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Reflective plane" Click="OnAddPlaneClicked" />
                <MenuItem Header="Acoustic box" Click="OnAddBoxClicked" />
                <MenuItem Header="Parametric room" Click="OnAddRoomClicked" />
                <MenuItem Header="Acoustic material" Click="OnAddMaterialClicked" />
                <MenuItem Header="Bounded wind zone" Click="OnAddWindZoneClicked" />
                <MenuItem Header="Atmosphere layer" Click="OnAddAtmosphereLayerClicked" />
                <MenuItem Header="Binaural head receiver" Click="OnAddBinauralReceiverClicked" />
                <MenuItem Header="Stereo microphone pair" Click="OnAddMicrophoneReceiverClicked" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <TreeView x:Name="SceneTree" Grid.Row="1" Margin="7,0" Background="Transparent" SelectionChanged="OnSceneTreeSelectionChanged" />
        <Border Grid.Row="2" Classes="panel" Margin="10" Padding="11">
          <StackPanel Spacing="8">
            <TextBlock Classes="sectionTitle" Text="SIMULATION SUMMARY" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Text="World units" Foreground="#8292A6" /><TextBlock Grid.Column="1" Classes="value" Text="SI / metres" />
              <TextBlock Grid.Row="1" Text="Emitters" Foreground="#8292A6" /><TextBlock x:Name="EmitterCountText" Grid.Row="1" Grid.Column="1" Classes="value" Text="1 mono" />
              <TextBlock Grid.Row="2" Text="Receiver takes" Foreground="#8292A6" /><TextBlock x:Name="ReceiverCountText" Grid.Row="2" Grid.Column="1" Classes="value" Text="2 stereo" />
              <TextBlock Grid.Row="3" Text="Duration" Foreground="#8292A6" /><TextBlock x:Name="DurationSummaryText" Grid.Row="3" Grid.Column="1" Classes="value" Text="6.000 s" />
            </Grid>
            <Border Height="1" Background="#2B3748" Margin="0,3" />
            <TextBlock x:Name="AtlasStateText" Classes="sectionTitle" Text="PRIVATE · LOCAL ONLY" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <Button x:Name="AtlasButton" Content="◇ Sign in" Click="OnAtlasClicked" ToolTip.Tip="Sign in to Atlas using authorization code + PKCE. The rotating refresh token is stored in Windows Credential Manager." />
              <Button x:Name="SyncButton" Grid.Column="1" Content="⇧ Sync" Click="OnSyncClicked" ToolTip.Tip="Explicitly upload the saved manifest and create an immutable Atlas project revision. Conflicts become named branches." />
            </Grid>
            <Button Content="♫  Import sound" Click="OnImportSoundClicked" ToolTip.Tip="Add a mono or stereo recording from WAV, AIFF, FLAC, MP3, Ogg Vorbis, or Opus. Choose explicitly how stereo channels enter the world." />
            <Button x:Name="ImportMeshButton" Content="▱  Import acoustic mesh" Click="OnImportMeshClicked" ToolTip.Tip="Copy an OBJ or self-contained glTF/GLB into this project's SHA-256 asset store and add it as a sound-blocking, echo-producing surface." />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Background="#090D12" RowDefinitions="Auto,*,Auto">
      <Border Background="#101820" BorderBrush="#293747" BorderThickness="0,0,0,1" Padding="10,8">
        <StackPanel Spacing="6">
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="SOUND SPACE" Foreground="#99B2C5" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,4" />
            <ComboBox x:Name="CameraViewBox" Width="137" MinHeight="28" Margin="0,0,6,4" SelectionChanged="OnCameraViewChanged" AutomationProperties.Name="Camera view" ToolTip.Tip="Use top, front, or side for accurate flat views. All views show the same scene." />
            <Button Classes="worldTool" Content="◎ Focus selection" Click="OnFocusSelectionClicked" Margin="0,0,6,4" ToolTip.Tip="Make the selected object or path point the fixed centre of camera orbit." />
            <Button Classes="worldTool" Content="Fit all" Click="OnFitViewportClicked" Margin="0,0,6,4" ToolTip.Tip="Frame the complete sound space (F in the world)." />
            <Button Classes="worldTool" Content="−" Click="OnZoomOutClicked" Margin="0,0,4,4" ToolTip.Tip="Zoom out. The mouse wheel also zooms." AutomationProperties.Name="Zoom out" />
            <Button Classes="worldTool" Content="+" Click="OnZoomInClicked" Margin="0,0,8,4" ToolTip.Tip="Zoom in around the camera pivot. The mouse wheel also zooms." AutomationProperties.Name="Zoom in" />
            <TextBlock x:Name="CameraPivotText" Text="Orbit around scene centre" Foreground="#748BA0" FontSize="10" VerticalAlignment="Center" Margin="0,0,0,4" />
          </WrapPanel>
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="WorldSelectButton" Classes="worldTool active" Tag="Select" Content="↖ Select" Click="OnWorldToolClicked" Margin="0,0,4,4" ToolTip.Tip="Select objects and path points without moving them. Never changes playback time." />
            <Button x:Name="WorldMoveButton" Classes="worldTool" Tag="Move" Content="✥ Move" Click="OnWorldToolClicked" Margin="0,0,4,4" ToolTip.Tip="Drag a point in the chosen plane or along a single axis. Escape cancels the move." />
            <Button x:Name="WorldOrbitButton" Classes="worldTool" Tag="Orbit" Content="⟳ Orbit" Click="OnWorldToolClicked" Margin="0,0,4,4" ToolTip.Tip="Left-drag to rotate the camera around its fixed focus point. Right-drag also orbits." />
            <Button x:Name="WorldPanButton" Classes="worldTool" Tag="Pan" Content="↔ Pan" Click="OnWorldToolClicked" Margin="0,0,10,4" ToolTip.Tip="Left-drag to shift the camera and its focus together. Middle-drag also pans." />
            <Button x:Name="GestureButton" Classes="worldTool" Content="● Record path" Click="OnGestureClicked" Margin="0,0,4,4" ToolTip.Tip="Record a new motion gesture for the selected path. Raw movement is preserved." />
          </WrapPanel>
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="Move along" Foreground="#8DA3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" />
            <ComboBox x:Name="MoveConstraintBox" Width="157" MinHeight="27" SelectionChanged="OnMoveConstraintChanged" AutomationProperties.Name="Movement plane or axis" />
            <CheckBox x:Name="WorldSnapCheck" Content="Snap 0.1 m" Margin="10,0" FontSize="11" IsCheckedChanged="OnWorldSnapChanged" ToolTip.Tip="Snap only the coordinates you move to a 10 cm grid. Locked coordinates are preserved." />
            <TextBlock Text="Y up · grid 2 m" Foreground="#8197AB" FontSize="10" VerticalAlignment="Center" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Row="1" ClipToBounds="True">
        <local:GpuWorldViewport x:Name="GpuViewport" IsHitTestVisible="False" />
        <local:WorldViewport x:Name="Viewport" AutomationProperties.Name="3D sound space. Select, move, orbit, or pan using the tools above." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Spacing="12" IsHitTestVisible="False">
          <TextBlock x:Name="ReflectionPathText" Text="ECHO ROUTES —" Foreground="#74CFC8" FontSize="9" />
          <TextBlock x:Name="ViewportPerformanceText" Text="GPU STARTING" Foreground="#718198" FontSize="9" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="#101820" BorderBrush="#293747" BorderThickness="0,1,0,0" Padding="10,7">
        <StackPanel Spacing="5">
          <TextBlock x:Name="WorldToolHelpText" Text="Select a point. Camera and point tools never change playback time." Foreground="#93ABBE" FontSize="11" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <TextBlock x:Name="WorldSelectionLabelText" Text="Position (m)" Foreground="#8DA3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="X" Foreground="#EF8990" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBox x:Name="WorldPositionX" Width="76" MinHeight="26" FontSize="11" AutomationProperties.Name="Selected position X in metres" />
            <TextBlock Text="Y ↑" Foreground="#7AD7AC" VerticalAlignment="Center" Margin="8,0,4,0" /><TextBox x:Name="WorldPositionY" Width="76" MinHeight="26" FontSize="11" AutomationProperties.Name="Selected height Y in metres" />
            <TextBlock Text="Z" Foreground="#7EA9F0" VerticalAlignment="Center" Margin="8,0,4,0" /><TextBox x:Name="WorldPositionZ" Width="76" MinHeight="26" FontSize="11" AutomationProperties.Name="Selected position Z in metres" />
            <Button x:Name="ApplyWorldPositionButton" Content="Apply XYZ" Classes="worldTool" Margin="8,0,0,0" Click="OnApplyWorldPositionClicked" ToolTip.Tip="Commit exact position coordinates; playback time stays unchanged." />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Grid.Column="2" Background="#10151D" BorderBrush="#253042" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="10">
          <Grid ColumnDefinitions="*,Auto" Margin="3,1,0,2">
            <StackPanel>
              <TextBlock Classes="sectionTitle" Text="PHYSICS INSPECTOR" />
              <TextBlock x:Name="InspectorSelectionText" Text="440 Hz moving primitive" Foreground="#E9F3F4" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#172631" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
              <TextBlock x:Name="InspectorKindBadge" Text="SOURCE" Foreground="#77DCD1" FontSize="9" FontWeight="SemiBold" />
            </Border>
          </Grid>

          <StackPanel x:Name="EmitterInspectorPanel" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock x:Name="EmitterNameText" Text="440 Hz moving primitive" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <CheckBox x:Name="SourceEnabledCheck" Content="Include this source" IsCheckedChanged="OnSourceEnabledChanged" />
                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Primitive" Foreground="#8192A7" />
                  <ComboBox x:Name="WaveformBox" Grid.Column="1" SelectionChanged="OnWaveformChanged" />
                  <TextBlock Grid.Row="1" Text="Frequency (Hz)" Foreground="#8192A7" /><TextBox x:Name="FrequencyBox" Grid.Row="1" Grid.Column="1" Text="440" HorizontalContentAlignment="Right" LostFocus="OnSignalValueCommitted" />
                  <TextBlock Grid.Row="2" Text="Linear gain" Foreground="#8192A7" /><TextBox x:Name="GainBox" Grid.Row="2" Grid.Column="1" Text="0.800" HorizontalContentAlignment="Right" LostFocus="OnSignalValueCommitted" />
                  <TextBlock Grid.Row="3" Text="Source mode" Foreground="#8192A7" /><TextBlock x:Name="SourceMappingText" Grid.Row="3" Grid.Column="1" Classes="value" Text="Mono point source" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="175" />
                  <TextBlock Grid.Row="4" Text="Propagation" Foreground="#8192A7" /><TextBlock x:Name="SourcePropagationText" Grid.Row="4" Grid.Column="1" Classes="value" Text="Retarded" TextAlignment="Right" />
                </Grid>
                <StackPanel x:Name="SamplePlaybackPanel" IsVisible="False" Spacing="8">
                  <TextBlock x:Name="SampleAssetText" Foreground="#91A4BD" TextWrapping="Wrap" FontSize="11" />
                  <Grid ColumnDefinitions="*,85" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="8">
                    <TextBlock Text="Start in scene (s)" Foreground="#8192A7" VerticalAlignment="Center" />
                    <TextBox x:Name="SampleStartBox" Grid.Column="1" Text="0" />
                    <TextBlock Grid.Row="1" Text="Skip into file (s)" Foreground="#8192A7" VerticalAlignment="Center" />
                    <TextBox x:Name="SampleOffsetBox" Grid.Row="1" Grid.Column="1" Text="0" />
                  </Grid>
                  <CheckBox x:Name="SampleLoopCheck" Content="Loop the whole recording" />
                  <TextBlock Text="File offset skips the beginning on the first pass. Later loops replay the whole recording." Foreground="#71839A" FontSize="10" TextWrapping="Wrap" />
                  <TextBlock x:Name="SampleTimingText" Text="Playback timing is independent of the motion path." Foreground="#71839A" FontSize="10" TextWrapping="Wrap" />
                  <TextBlock Text="Alpha acoustics: recording tone changes from air and surface materials currently use an approximate 1 kHz response." Foreground="#A59574" FontSize="10" TextWrapping="Wrap" />
                  <Button Content="Apply playback" Click="OnApplySamplePlaybackClicked" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionTitle" Text="MOTION AT PLAYHEAD" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                  <TextBlock Text="Position X" Foreground="#8192A7" /><TextBlock x:Name="PositionX" Grid.Column="1" Classes="value" Text="−28.000 m" />
                  <TextBlock Grid.Row="1" Text="Position Y" Foreground="#8192A7" /><TextBlock x:Name="PositionY" Grid.Row="1" Grid.Column="1" Classes="value" Text="1.700 m" />
                  <TextBlock Grid.Row="2" Text="Position Z" Foreground="#8192A7" /><TextBlock x:Name="PositionZ" Grid.Row="2" Grid.Column="1" Classes="value" Text="4.000 m" />
                  <TextBlock Grid.Row="3" Text="Radial velocity" Foreground="#8192A7" /><TextBlock x:Name="VelocityText" Grid.Row="3" Grid.Column="1" Classes="value" Text="9.73 m/s" />
                </Grid>
                <Border Height="1" Background="#293444" Margin="0,4" />
                <TextBlock x:Name="SelectedPointText" Text="KEYFRAME 1 · t 0.000 s" Classes="sectionTitle" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" Foreground="#8192A7" VerticalAlignment="Center" />
                  <TextBox x:Name="KeyframeX" Grid.Column="1" Text="-28.000" LostFocus="OnKeyframeValueCommitted" />
                  <TextBlock Grid.Column="2" Text="Y" Foreground="#8192A7" VerticalAlignment="Center" />
                  <TextBox x:Name="KeyframeY" Grid.Column="3" Text="1.700" LostFocus="OnKeyframeValueCommitted" />
                  <TextBlock Grid.Column="4" Text="Z" Foreground="#8192A7" VerticalAlignment="Center" />
                  <TextBox x:Name="KeyframeZ" Grid.Column="5" Text="4.000" LostFocus="OnKeyframeValueCommitted" />
                </Grid>
                <TextBlock Text="Use Move and choose a plane or axis above the world. These fields edit the selected path point, not playback time." TextWrapping="Wrap" Foreground="#8197AB" FontSize="10" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="MaterialInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Surface behavior" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <TextBlock Text="Material name" Foreground="#8192A7" />
                <TextBox x:Name="MaterialNameBox" />
                <TextBlock Text="Starting point" Foreground="#8192A7" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <ComboBox x:Name="MaterialPresetBox" SelectionChanged="OnMaterialPresetChanged" />
                  <Button Grid.Column="1" Content="Load" Click="OnLoadMaterialPresetClicked" ToolTip.Tip="Load these coefficients into the editor without changing the scene until Apply material is pressed." />
                </Grid>
                <TextBlock x:Name="MaterialPresetDescriptionText" Text="Preset values are adjustable starting points, not certified measurements." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
                <Border Height="1" Background="#293444" Margin="0,3" />
                <Grid ColumnDefinitions="54,*,*,*" ColumnSpacing="5">
                  <TextBlock Text="Hz" Classes="sectionTitle" />
                  <TextBlock Grid.Column="1" Text="SOAK" Classes="sectionTitle" TextAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="SCATTER" Classes="sectionTitle" TextAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="PASS" Classes="sectionTitle" TextAlignment="Center" />
                </Grid>
                <StackPanel x:Name="MaterialBandRows" Spacing="4" />
                <TextBlock Text="Each value runs from 0 to 1. Soak removes sound, scatter sends reflected sound away from the clear echo path, and pass lets sound through the boundary." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
                <Grid ColumnDefinitions="*,92" ColumnSpacing="8">
                  <TextBlock Text="Surface roughness (0 smooth · 1 coarse)" Foreground="#8192A7" TextWrapping="Wrap" />
                  <TextBox x:Name="MaterialRoughnessBox" Grid.Column="1" HorizontalContentAlignment="Right" LostFocus="OnMaterialDraftChanged" />
                </Grid>
                <TextBlock x:Name="MaterialUsageText" Text="Used by 1 surface" TextWrapping="Wrap" Foreground="#91A4BD" FontSize="9" />
                <Border Height="1" Background="#293444" Margin="0,3" />
                <TextBlock Classes="sectionTitle" Text="LISTEN TO THIS MATERIAL" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <ComboBox x:Name="MaterialAuditionBandBox" />
                  <Button Grid.Column="1" Content="▶  Audition" Click="OnAuditionMaterialClicked" ToolTip.Tip="Play a short tone and its reflection through the current, unapplied material values. The project is not changed." />
                </Grid>
                <TextBlock Text="Choose one pitch band to hear its clear reflection and scattered tail. This uses the values currently shown, even before Apply material." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>

            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="7">
                <TextBlock Classes="sectionTitle" Text="AVERAGE ENERGY MAP" />
                <Grid ColumnDefinitions="72,*,42" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="6">
                  <TextBlock Text="Soaked up" Foreground="#8192A7" />
                  <ProgressBar x:Name="MaterialAbsorbedBar" Grid.Column="1" Minimum="0" Maximum="100" Height="7" VerticalAlignment="Center" />
                  <TextBlock x:Name="MaterialAbsorbedText" Grid.Column="2" Classes="value" Text="0%" TextAlignment="Right" />
                  <TextBlock Grid.Row="1" Text="Clear echo" Foreground="#8192A7" />
                  <ProgressBar x:Name="MaterialClearEchoBar" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Height="7" VerticalAlignment="Center" />
                  <TextBlock x:Name="MaterialClearEchoText" Grid.Row="1" Grid.Column="2" Classes="value" Text="0%" TextAlignment="Right" />
                  <TextBlock Grid.Row="2" Text="Sent away" Foreground="#8192A7" />
                  <ProgressBar x:Name="MaterialScatteredBar" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Height="7" VerticalAlignment="Center" />
                  <TextBlock x:Name="MaterialScatteredText" Grid.Row="2" Grid.Column="2" Classes="value" Text="0%" TextAlignment="Right" />
                  <TextBlock Grid.Row="3" Text="Passes through" Foreground="#8192A7" />
                  <ProgressBar x:Name="MaterialTransmittedBar" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Height="7" VerticalAlignment="Center" />
                  <TextBlock x:Name="MaterialTransmittedText" Grid.Row="3" Grid.Column="2" Classes="value" Text="0%" TextAlignment="Right" />
                </Grid>
                <TextBlock x:Name="MaterialEnergyHintText" Text="Averages summarize all frequency bands." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <Button Content="Apply material" Background="#266A64" Foreground="White" Click="OnApplyMaterialClicked" />
              <Button Grid.Column="1" Content="Duplicate" Click="OnDuplicateMaterialClicked" ToolTip.Tip="Create an independent copy for quick side-by-side surface tuning." />
              <Button Grid.Column="2" Content="Remove" Background="#3A2328" Foreground="#F0B6BC" Click="OnRemoveSelectedClicked" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="GeometryInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="GeometryKindText" Text="Reflective plane" Foreground="#E9F3F4" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="SI" Classes="sectionTitle" />
                </Grid>
                <TextBlock Text="Position (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryPositionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryPositionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryPositionZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Authored dimensions (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryDimensionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryDimensionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryDimensionZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Rotation (degrees)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryRotationX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryRotationY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryRotationZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Scale" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryScaleX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryScaleY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="GeometryScaleZ" Grid.Column="5" />
                </Grid>
                <Grid ColumnDefinitions="*,130" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Acoustic material" Foreground="#8192A7" VerticalAlignment="Center" />
                  <ComboBox x:Name="GeometryMaterialBox" Grid.Column="1" />
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="GeometryOccludesBox" Content="Blocks sound" />
                    <CheckBox x:Name="GeometryReflectsBox" Content="Creates echoes" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="GeometryConstraintText" Text="Drag the selected centre handle in the world for X/Z movement." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
                <Border x:Name="MeshMaterialRegionPanel" IsVisible="False" Background="#111B25" BorderBrush="#28394A" BorderThickness="1" CornerRadius="5" Padding="9">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="sectionTitle" Text="SOURCE MATERIAL REGIONS" />
                      <Button x:Name="RefreshMeshRegionsButton" Grid.Column="1" Content="READ MESH" Padding="7,2" FontSize="9" Click="OnRefreshMeshRegionsClicked" ToolTip.Tip="Re-read the verified content-addressed mesh and retain its submesh/material regions." />
                    </Grid>
                    <TextBlock x:Name="MeshMaterialRegionSummaryText" Text="No source regions retained yet." TextWrapping="Wrap" Foreground="#8192A7" FontSize="9" />
                    <Grid ColumnDefinitions="*,130" RowDefinitions="Auto,Auto" RowSpacing="6">
                      <TextBlock Text="Source region" Foreground="#8192A7" VerticalAlignment="Center" />
                      <ComboBox x:Name="GeometryRegionBox" Grid.Column="1" SelectionChanged="OnGeometryRegionSelectionChanged" />
                      <TextBlock Grid.Row="1" Text="Acoustic material" Foreground="#8192A7" VerticalAlignment="Center" />
                      <ComboBox x:Name="GeometryRegionMaterialBox" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <TextBlock Text="Each source submesh keeps its own acoustic surface. The main material above remains the explicit fallback for any region not listed here." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
                  </StackPanel>
                </Border>
                <Border x:Name="RoomDecayPanel" IsVisible="False" Background="#111B25" BorderBrush="#28394A" BorderThickness="1" CornerRadius="5" Padding="9">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="sectionTitle" Text="ESTIMATED NATURAL ROOM FADE" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                      <TextBlock Text="Bass (250 Hz) · active" Foreground="#8192A7" /><TextBlock x:Name="RoomLowDecayText" Grid.Column="1" Classes="value" Text="0.00 s" />
                      <TextBlock Grid.Row="1" Text="Voice (1 kHz) · active" Foreground="#8192A7" /><TextBlock x:Name="RoomMidDecayText" Grid.Row="1" Grid.Column="1" Classes="value" Text="0.00 s" />
                      <TextBlock Grid.Row="2" Text="Brightness (8 kHz) · active" Foreground="#8192A7" /><TextBlock x:Name="RoomHighDecayText" Grid.Row="2" Grid.Column="1" Classes="value" Text="0.00 s" />
                      <TextBlock Grid.Row="3" Text="Average wall interval" Foreground="#8192A7" /><TextBlock x:Name="RoomReflectionIntervalText" Grid.Row="3" Grid.Column="1" Classes="value" Text="0.0 ms" />
                      <TextBlock Grid.Row="4" Text="Profile fade cap" Foreground="#8192A7" /><TextBlock x:Name="RoomProfileTailText" Grid.Row="4" Grid.Column="1" Classes="value" Text="0.00 s" />
                    </Grid>
                    <TextBlock Text="All three frequency bands drive separate room tails. The active profile fade cap can shorten any band, but never extends its physically estimated decay." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Content="Apply geometry" Background="#266A64" Foreground="White" Click="OnApplyGeometryClicked" />
              <Button Grid.Column="1" Content="Remove" Background="#3A2328" Foreground="#F0B6BC" Click="OnRemoveSelectedClicked" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="WindInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Bounded wind field" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <TextBlock Text="Position (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindPositionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindPositionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindPositionZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Dimensions (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindDimensionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindDimensionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindDimensionZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Rotation (degrees)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindRotationX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindRotationY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindRotationZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Scale" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindScaleX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindScaleY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindScaleZ" Grid.Column="5" />
                </Grid>
                <TextBlock Text="Velocity (m/s, world axes)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindVelocityX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindVelocityY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="WindVelocityZ" Grid.Column="5" />
                </Grid>
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Turbulence (0–1)" Foreground="#8192A7" /><TextBox x:Name="WindTurbulence" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Noise seed" Foreground="#8192A7" /><TextBox x:Name="WindNoiseSeed" Grid.Row="1" Grid.Column="1" />
                </Grid>
                <TextBlock Text="Drag the selected centre handle in the world for X/Z movement. The dashed box is the active field boundary." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Content="Apply wind field" Background="#266A64" Foreground="White" Click="OnApplyWindClicked" />
              <Button Grid.Column="1" Content="Remove" Background="#3A2328" Foreground="#F0B6BC" Click="OnRemoveSelectedClicked" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="LayerInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Altitude-bounded air layer" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Bottom altitude (m)" Foreground="#8192A7" /><TextBox x:Name="LayerBaseAltitude" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Top altitude (m)" Foreground="#8192A7" /><TextBox x:Name="LayerTopAltitude" Grid.Row="1" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="Temperature (°C)" Foreground="#8192A7" /><TextBox x:Name="LayerTemperature" Grid.Row="2" Grid.Column="1" />
                  <TextBlock Grid.Row="3" Text="Humidity (%)" Foreground="#8192A7" /><TextBox x:Name="LayerHumidity" Grid.Row="3" Grid.Column="1" />
                  <TextBlock Grid.Row="4" Text="Pressure (kPa)" Foreground="#8192A7" /><TextBox x:Name="LayerPressure" Grid.Row="4" Grid.Column="1" />
                </Grid>
                <TextBlock Text="Layers may have gaps, where base air applies, but they cannot overlap." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Content="Apply air layer" Background="#266A64" Foreground="White" Click="OnApplyLayerClicked" />
              <Button Grid.Column="1" Content="Remove" Background="#3A2328" Foreground="#F0B6BC" Click="OnRemoveSelectedClicked" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="BaseAtmosphereInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Base air outside authored layers" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Temperature (°C)" Foreground="#8192A7" /><TextBox x:Name="BaseTemperature" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Humidity (%)" Foreground="#8192A7" /><TextBox x:Name="BaseHumidity" Grid.Row="1" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="Pressure (kPa)" Foreground="#8192A7" /><TextBox x:Name="BasePressure" Grid.Row="2" Grid.Column="1" />
                </Grid>
                <Button Content="Apply base air" Background="#266A64" Foreground="White" Click="OnApplyBaseAtmosphereClicked" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ReceiverInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="ReceiverKindText" Text="Stereo receiver rig" Foreground="#E9F3F4" FontWeight="SemiBold" />
                  <CheckBox x:Name="ReceiverEnabledBox" Grid.Column="1" Content="Enabled" />
                </Grid>
                <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Take name" Foreground="#8192A7" /><TextBox x:Name="ReceiverNameBox" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Motion" Foreground="#8192A7" /><ComboBox x:Name="ReceiverMotionPathBox" Grid.Row="1" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="Rig yaw (degrees)" Foreground="#8192A7" /><TextBox x:Name="ReceiverYaw" Grid.Row="2" Grid.Column="1" />
                </Grid>
                <TextBlock Text="Static centre position (m)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="ReceiverPositionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="ReceiverPositionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="ReceiverPositionZ" Grid.Column="5" />
                </Grid>
                <TextBlock x:Name="ReceiverMotionHint" Text="Drag this static rig in the world for X/Z movement, or assign an authored motion path." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>

            <Border x:Name="BinauralReceiverPanel" Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Binaural head model" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Ear spacing (m)" Foreground="#8192A7" /><TextBox x:Name="ReceiverEarSpacing" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Head radius (m)" Foreground="#8192A7" /><TextBox x:Name="ReceiverHeadRadius" Grid.Row="1" Grid.Column="1" />
                </Grid>
                <TextBlock Text="Head dimensions (m, project metadata)" Foreground="#8192A7" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                  <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="ReceiverHeadDimensionX" Grid.Column="1" />
                  <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="ReceiverHeadDimensionY" Grid.Column="3" />
                  <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="ReceiverHeadDimensionZ" Grid.Column="5" />
                </Grid>
                <Grid ColumnDefinitions="*,130" RowDefinitions="Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Head response" Foreground="#8192A7" /><ComboBox x:Name="ReceiverHrtfModeBox" Grid.Column="1" SelectionChanged="OnReceiverHrtfModeChanged" />
                  <TextBlock Grid.Row="1" Text="SOFA dataset" Foreground="#8192A7" /><ComboBox x:Name="ReceiverSofaAssetBox" Grid.Row="1" Grid.Column="1" />
                </Grid>
                <Button x:Name="ImportSofaButton" Content="Import SOFA dataset" Click="OnImportSofaClicked" ToolTip.Tip="Copy a measured .sofa HRTF dataset into this project's private content-addressed asset store." />
                <TextBlock x:Name="ReceiverHrtfStatusText" Text="The analytic head model is active. Measured SOFA modes are authorable but remain render-gated until the Steam Audio adapter is active." TextWrapping="Wrap" Foreground="#A99B67" FontSize="9" />
              </StackPanel>
            </Border>

            <StackPanel x:Name="MicrophoneReceiverPanel" Spacing="8">
              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Left microphone capsule" Foreground="#E9F3F4" FontWeight="SemiBold" />
                  <TextBlock Text="Offset from rig centre (m)" Foreground="#8192A7" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                    <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="LeftCapsulePositionX" Grid.Column="1" />
                    <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="LeftCapsulePositionY" Grid.Column="3" />
                    <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="LeftCapsulePositionZ" Grid.Column="5" />
                  </Grid>
                  <TextBlock Text="Aim rotation (degrees)" Foreground="#8192A7" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                    <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="LeftCapsuleRotationX" Grid.Column="1" />
                    <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="LeftCapsuleRotationY" Grid.Column="3" />
                    <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="LeftCapsuleRotationZ" Grid.Column="5" />
                  </Grid>
                  <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Text="Pickup pattern" Foreground="#8192A7" /><ComboBox x:Name="LeftCapsulePatternBox" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Text="Sensitivity (dB)" Foreground="#8192A7" /><TextBox x:Name="LeftCapsuleSensitivity" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="Self-noise (dB SPL)" Foreground="#8192A7" /><TextBox x:Name="LeftCapsuleSelfNoise" Grid.Row="2" Grid.Column="1" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="panel" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Right microphone capsule" Foreground="#E9F3F4" FontWeight="SemiBold" />
                  <TextBlock Text="Offset from rig centre (m)" Foreground="#8192A7" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                    <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="RightCapsulePositionX" Grid.Column="1" />
                    <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="RightCapsulePositionY" Grid.Column="3" />
                    <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="RightCapsulePositionZ" Grid.Column="5" />
                  </Grid>
                  <TextBlock Text="Aim rotation (degrees)" Foreground="#8192A7" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="5">
                    <TextBlock Text="X" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="RightCapsuleRotationX" Grid.Column="1" />
                    <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="RightCapsuleRotationY" Grid.Column="3" />
                    <TextBlock Text="Z" Grid.Column="4" VerticalAlignment="Center" Foreground="#8192A7" /><TextBox x:Name="RightCapsuleRotationZ" Grid.Column="5" />
                  </Grid>
                  <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Text="Pickup pattern" Foreground="#8192A7" /><ComboBox x:Name="RightCapsulePatternBox" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Text="Sensitivity (dB)" Foreground="#8192A7" /><TextBox x:Name="RightCapsuleSensitivity" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="Self-noise (dB SPL)" Foreground="#8192A7" /><TextBox x:Name="RightCapsuleSelfNoise" Grid.Row="2" Grid.Column="1" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="Capsule position, aim, pickup pattern, and sensitivity are active in preview and final rendering. Self-noise and saved calibration curves remain metadata until calibrated response processing lands." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Content="Apply receiver" Background="#266A64" Foreground="White" Click="OnApplyReceiverClicked" />
              <Button Grid.Column="1" Content="Remove" Background="#3A2328" Foreground="#F0B6BC" Click="OnRemoveSelectedClicked" />
            </Grid>
          </StackPanel>

          <StackPanel x:Name="RenderProfileInspectorPanel" IsVisible="False" Spacing="10">
            <Border Classes="panel" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="Preview and final echo quality" Foreground="#E9F3F4" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,132" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Text="Profile name" Foreground="#8192A7" /><TextBox x:Name="RenderProfileNameBox" Grid.Column="1" />
                  <TextBlock Grid.Row="1" Text="Quality mode" Foreground="#8192A7" /><ComboBox x:Name="RenderQualityBox" Grid.Row="1" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="Sample rate" Foreground="#8192A7" /><ComboBox x:Name="RenderSampleRateBox" Grid.Row="2" Grid.Column="1" />
                  <TextBlock Grid.Row="3" Text="File precision" Foreground="#8192A7" /><ComboBox x:Name="RenderSampleFormatBox" Grid.Row="3" Grid.Column="1" SelectionChanged="OnRenderSampleFormatChanged" />
                  <TextBlock Grid.Row="4" Text="Dither" Foreground="#8192A7" /><ComboBox x:Name="RenderDitherBox" Grid.Row="4" Grid.Column="1" />
                  <TextBlock Grid.Row="5" Text="Audio buffer (frames)" Foreground="#8192A7" /><TextBox x:Name="RenderBufferFramesBox" Grid.Row="5" Grid.Column="1" HorizontalContentAlignment="Right" />
                  <TextBlock Grid.Row="6" Text="Room bounce depth (0–2)" Foreground="#8192A7" /><TextBox x:Name="RenderReflectionOrderBox" Grid.Row="6" Grid.Column="1" HorizontalContentAlignment="Right" />
                  <TextBlock Grid.Row="7" Text="Diffuse detail budget" Foreground="#8192A7" /><TextBox x:Name="RenderRayCountBox" Grid.Row="7" Grid.Column="1" HorizontalContentAlignment="Right" />
                  <TextBlock Grid.Row="8" Text="Echo fade time (s)" Foreground="#8192A7" /><TextBox x:Name="RenderTailSecondsBox" Grid.Row="8" Grid.Column="1" HorizontalContentAlignment="Right" />
                  <TextBlock Grid.Row="9" Text="Air path slices" Foreground="#8192A7" /><TextBox x:Name="RenderAtmosphereSegmentsBox" Grid.Row="9" Grid.Column="1" HorizontalContentAlignment="Right" />
                </Grid>
                <Grid ColumnDefinitions="*,132">
                  <TextBlock Text="Repeatable random seed" Foreground="#8192A7" /><TextBox x:Name="RenderSeedBox" Grid.Column="1" HorizontalContentAlignment="Right" />
                </Grid>
                <TextBlock x:Name="RenderProfileExplanationText" Text="Depth 2 adds an opposing-wall second bounce inside axis-aligned rooms. Authored planes and boxes remain first-bounce." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              </StackPanel>
            </Border>
            <Button Content="Apply as active profile" Background="#266A64" Foreground="White" Click="OnApplyRenderProfileClicked" />
          </StackPanel>

          <Border x:Name="ReadOnlyInspectorPanel" IsVisible="False" Classes="panel" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock x:Name="ReadOnlySelectionTitle" Text="Selection" Foreground="#E9F3F4" FontWeight="SemiBold" />
              <TextBlock x:Name="ReadOnlySelectionMessage" Text="This object remains visible here while its dedicated controls are developed." TextWrapping="Wrap" Foreground="#8192A7" />
            </StackPanel>
          </Border>

          <Border Classes="panel" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="SPECTRAL DECOMPOSITION" />
              <TextBlock Text="Break a rendered stereo take into editable tones, transients, and remaining texture. The untouched take is retained as the reference." TextWrapping="Wrap" Foreground="#8192A7" FontSize="10" />
              <TextBlock Text="Receiver take" Foreground="#8192A7" />
              <ComboBox x:Name="AnalysisTakeBox" />
              <TextBlock Text="How to interpret stereo" Foreground="#8192A7" />
              <ComboBox x:Name="AnalysisChannelModeBox" SelectionChanged="OnAnalysisChannelModeChanged" />
              <TextBlock x:Name="AnalysisModeHelpText" Text="Track the same tones across left and right while retaining each channel's level and phase." TextWrapping="Wrap" Foreground="#65778C" FontSize="9" />
              <Grid ColumnDefinitions="*,90">
                <TextBlock Text="Tones kept per frame" Foreground="#8192A7" VerticalAlignment="Center" />
                <TextBox x:Name="AnalysisMaxPartialsBox" Grid.Column="1" Text="24" HorizontalContentAlignment="Right" />
              </Grid>
              <TextBlock x:Name="AnalysisResultText" Text="Render a receiver take, save the project, then choose Analyze." TextWrapping="Wrap" Foreground="#83D8CD" FontSize="10" />
            </StackPanel>
          </Border>

          <Border Classes="panel" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Classes="sectionTitle" Text="FIELD SUMMARY" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                <TextBlock Text="Temperature" Foreground="#8192A7" /><TextBlock x:Name="TemperatureText" Grid.Column="1" Classes="value" Text="20.0 °C" />
                <TextBlock Grid.Row="1" Text="Humidity" Foreground="#8192A7" /><TextBlock x:Name="HumidityText" Grid.Row="1" Grid.Column="1" Classes="value" Text="50.0 %" />
                <TextBlock Grid.Row="2" Text="Pressure" Foreground="#8192A7" /><TextBlock x:Name="PressureText" Grid.Row="2" Grid.Column="1" Classes="value" Text="101.325 kPa" />
                <TextBlock Grid.Row="3" Text="Altitude layers" Foreground="#8192A7" /><TextBlock x:Name="LayerCountText" Grid.Row="3" Grid.Column="1" Classes="value" Text="0 · base air" />
                <TextBlock Grid.Row="4" Text="Wind zones" Foreground="#8192A7" /><TextBlock x:Name="WindText" Grid.Row="4" Grid.Column="1" Classes="value" Text="1 bounded · 2.00 m/s" />
                <TextBlock Grid.Row="5" Text="Base sound speed" Foreground="#8192A7" /><TextBlock x:Name="EffectiveSpeedText" Grid.Row="5" Grid.Column="1" Classes="value" Text="344.04 m/s" />
                <TextBlock Grid.Row="6" Text="Preview sampling" Foreground="#8192A7" /><TextBlock x:Name="FieldQualityText" Grid.Row="6" Grid.Column="1" Classes="value" Text="1 / path leg" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Background="#101F20" BorderBrush="#22544E" BorderThickness="1" CornerRadius="6" Padding="11">
            <TextBlock TextWrapping="Wrap" Foreground="#83D8CD" FontSize="11" Text="Preview samples each propagation leg once. Final profiles subdivide every direct and reflected path through authored air and wind fields." />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#121C25" BorderBrush="#35485A" BorderThickness="0,1" Padding="12,6">
      <Grid RowDefinitions="Auto,*" RowSpacing="4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="PLAYBACK" FontSize="10" FontWeight="SemiBold" Foreground="#9CB3C7" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button x:Name="RewindButton" Content="|◀ Start" Click="OnRewindClicked" ToolTip.Tip="Rewind to the beginning and stop (Home)." AutomationProperties.Name="Rewind to start" />
            <Button Content="−1 s" Click="OnBackOneSecondClicked" ToolTip.Tip="Go back one second and stop." />
            <Button x:Name="PlayButton" Content="▶ Play" Click="OnPlayClicked" Background="#266A64" ToolTip.Tip="Play or pause from the cursor (Space). At the end, Play starts again." />
            <Button Content="■ Stop" Click="OnStopClicked" ToolTip.Tip="Stop and keep the cursor here. Start rewinds to zero." />
            <Button Content="+1 s" Click="OnForwardOneSecondClicked" ToolTip.Tip="Go forward one second and stop." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="Time" Foreground="#91A7BA" VerticalAlignment="Center" />
            <TextBox x:Name="SeekTimeBox" Text="0.000" Width="86" MinHeight="28" HorizontalContentAlignment="Right" KeyDown="OnSeekTimeKeyDown" AutomationProperties.Name="Playback position in seconds" />
            <TextBlock x:Name="PositionText" Text="/ 6.000 s" Classes="value" VerticalAlignment="Center" />
            <Button Content="Go" Click="OnSeekTimeClicked" ToolTip.Tip="Jump to the entered time and stop. Press Enter in the time field to do the same." />
          </StackPanel>
        </Grid>
        <local:SceneTimelineControl x:Name="SceneTimeline" Grid.Row="1" MinHeight="48" />
      </Grid>
    </Border>
    <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#293746" />
    <Border Grid.Row="4" Grid.ColumnSpan="3" Background="#0E131B" BorderBrush="#273244" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="36,*">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,0">
          <Button x:Name="SignalWorkspaceButton" Grid.Column="0" Content="SIGNAL GRAPH" Background="Transparent" Foreground="#71DCCF" Click="OnSignalWorkspaceClicked" />
          <Button x:Name="SpectrumWorkspaceButton" Grid.Column="1" Content="SPECTRUM" Background="Transparent" Foreground="#8191A6" Click="OnSpectrumWorkspaceClicked" />
          <Button x:Name="ReceiverTakesWorkspaceButton" Grid.Column="2" Content="RECEIVER TAKES" Background="Transparent" Foreground="#8191A6" Click="OnReceiverTakesWorkspaceClicked" />
          <TextBlock Grid.Column="3" Grid.ColumnSpan="2" x:Name="StatusText" Text="Ready · select a sound or press Play" Foreground="#8DA2B8" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Grid x:Name="SignalWorkspace" Grid.Row="1" ColumnDefinitions="340,*,330" Margin="10,0,10,10">
          <Border Classes="panel" Padding="12">
            <Canvas Height="175">
              <Border Canvas.Left="8" Canvas.Top="39" Width="108" Height="68" CornerRadius="6" Background="#172931" BorderBrush="#3A8E86" BorderThickness="1" Padding="9">
                <StackPanel><TextBlock x:Name="SignalNodeTitle" Text="SINE" Foreground="#72E0D3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SignalFrequencyText" Text="440.00 Hz" Classes="value" Margin="0,9,0,0"/><TextBlock x:Name="SignalPlaybackText" Text="phase continuous" Foreground="#6F8295" FontSize="9"/></StackPanel>
              </Border>
              <Path Data="M116,73 L193,73" Stroke="#57C8BC" StrokeThickness="2" />
              <Ellipse Canvas.Left="189" Canvas.Top="69" Width="8" Height="8" Fill="#57C8BC" />
              <Border Canvas.Left="197" Canvas.Top="39" Width="112" Height="68" CornerRadius="6" Background="#222331" BorderBrush="#625B86" BorderThickness="1" Padding="9">
                <StackPanel><TextBlock x:Name="SignalOutputTitle" Text="POINT EMITTER" Foreground="#C5BFE8" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="SignalOutputChannelsText" Text="mono out" Classes="value" Margin="0,9,0,0"/><TextBlock x:Name="SignalGainText" Text="gain 0.800" Foreground="#7D7894" FontSize="9"/></StackPanel>
              </Border>
            </Canvas>
          </Border>
          <Border Grid.Column="1" Classes="panel" Margin="8,0" Padding="12">
            <StackPanel Spacing="12">
              <TextBlock Text="SELECTED SOUND" Classes="sectionTitle" />
              <TextBlock x:Name="TimelineSourceText" Text="440 Hz flyby · source active" Foreground="#8FE4D3" TextWrapping="Wrap" />
              <TextBlock Text="Use the playback ruler above to move through time. Select and move path points in the sound space independently." Foreground="#8DA2B8" TextWrapping="Wrap" FontSize="11" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="panel" Padding="12">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="ReceiverOneText" Text="Parametric listener" Foreground="#DCE8EE"/><TextBlock Grid.Column="1" Text="L    R" Classes="value" Foreground="#67D9CD"/></Grid>
              <TextBlock Text="Independent left / right capture" Foreground="#78BFB6" FontSize="10" />
              <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="ReceiverTwoText" Text="ORTF microphone pair" Foreground="#DCE8EE"/><TextBlock Grid.Column="1" Text="L    R" Classes="value" Foreground="#B1A4E2"/></Grid>
              <TextBlock Text="Independent left / right capture" Foreground="#AA9DCF" FontSize="10" />
              <TextBlock Text="Each rig renders an isolated stereo take." Foreground="#697B90" FontSize="10" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="SpectrumWorkspace" Grid.Row="1" ColumnDefinitions="245,*,285" Margin="10,0,10,10" IsVisible="False">
          <Border Classes="panel" Padding="11">
            <StackPanel Spacing="7">
              <TextBlock Classes="sectionTitle" Text="IMPORTED ANALYSIS" />
              <ComboBox x:Name="SpectralSessionBox" SelectionChanged="OnSpectralSessionChanged" />
              <TextBlock x:Name="SpectralSessionSummaryText" Text="Save and analyze a receiver take to populate this workspace." TextWrapping="Wrap" Foreground="#71839A" FontSize="9" />
              <Border Height="1" Background="#2B3748" Margin="0,2" />
              <Grid ColumnDefinitions="Auto,*,62" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="5" RowSpacing="5">
                <CheckBox x:Name="SpectralPartialsEnabled" IsChecked="True" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Tracked tones" Foreground="#8FE4D3" VerticalAlignment="Center" />
                <TextBox x:Name="SpectralPartialsGain" Grid.Column="2" Text="1.0" HorizontalContentAlignment="Right" />
                <CheckBox x:Name="SpectralTransientsEnabled" Grid.Row="1" IsChecked="True" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Impacts / attacks" Foreground="#DCC47D" VerticalAlignment="Center" />
                <TextBox x:Name="SpectralTransientsGain" Grid.Row="1" Grid.Column="2" Text="1.0" HorizontalContentAlignment="Right" />
                <CheckBox x:Name="SpectralStochasticEnabled" Grid.Row="2" IsChecked="True" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Texture / noise" Foreground="#B1A4E2" VerticalAlignment="Center" />
                <TextBox x:Name="SpectralStochasticGain" Grid.Row="2" Grid.Column="2" Text="1.0" HorizontalContentAlignment="Right" />
              </Grid>
              <TextBlock Text="Gain: 0–4 · unedited layers recombine to the original timing and stereo alignment." TextWrapping="Wrap" Foreground="#596B80" FontSize="9" />
              <TextBlock x:Name="SpectralEditStateText" Text="No edit selected" Foreground="#83D8CD" FontSize="9" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="panel" Margin="8,0" Padding="9">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SpectralPlotTitleText" Text="TIME × FREQUENCY" Classes="sectionTitle" />
                <TextBlock Grid.Column="1" Text="L / MID     R / SIDE" Foreground="#71839A" FontSize="9" />
              </Grid>
              <local:SpectralTrackView x:Name="SpectralTrackPlot" Grid.Row="1" Margin="0,7,0,0" />
            </Grid>
          </Border>

          <Border Grid.Column="2" Classes="panel" Padding="11">
            <StackPanel Spacing="5">
              <TextBlock Classes="sectionTitle" Text="SELECTED TONE" />
              <TextBlock x:Name="SpectralTrackNameText" Text="Click a tone path" Foreground="#E5EDF2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="SpectralTrackRangeText" Text="Frequency and channel details appear here." Foreground="#71839A" FontSize="9" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,90" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                <TextBlock Text="Include tone" Foreground="#8192A7" VerticalAlignment="Center" /><CheckBox x:Name="SpectralTrackEnabled" Grid.Column="1" IsChecked="True" IsEnabled="False" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="Tone gain (0–4)" Foreground="#8192A7" VerticalAlignment="Center" /><TextBox x:Name="SpectralTrackGain" Grid.Row="1" Grid.Column="1" Text="1.0" IsEnabled="False" HorizontalContentAlignment="Right" />
                <TextBlock Grid.Row="2" Text="Pitch (semitones)" Foreground="#8192A7" VerticalAlignment="Center" /><TextBox x:Name="SpectralTrackPitch" Grid.Row="2" Grid.Column="1" Text="0" IsEnabled="False" HorizontalContentAlignment="Right" ToolTip.Tip="Raises or lowers only this tracked tone. The stored analysis is never overwritten." />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button x:Name="SpectralApplyTrackButton" Content="Apply tone" IsEnabled="False" Background="#266A64" Foreground="White" Click="OnApplySpectralTrackClicked" />
                <Button x:Name="SpectralResetTrackButton" Grid.Column="1" Content="Reset tone" IsEnabled="False" Click="OnResetSpectralTrackClicked" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Button x:Name="SpectralAuditionButton" Content="▶  Hear" Click="OnAuditionSpectralClicked" />
                <Button x:Name="SpectralSaveEditButton" Grid.Column="1" Content="⌑  Save edit" Click="OnSaveSpectralEditClicked" />
                <Button x:Name="SpectralRenderButton" Grid.Column="2" Content="⇥  WAV" Background="#353056" Foreground="#DED7FA" Click="OnRenderSpectralClicked" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="ReceiverTakesWorkspace" Grid.Row="1" ColumnDefinitions="285,*,320" Margin="10,0,10,10" IsVisible="False">
          <Border Classes="panel" Padding="11">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Classes="sectionTitle" Text="RECORDED LISTENING POINTS" />
              <ListBox x:Name="ReceiverTakeList" Grid.Row="1" Margin="0,7" SelectionChanged="OnReceiverTakeSelectionChanged" />
              <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock x:Name="ReceiverTakeCountText" Text="No project takes yet" Foreground="#83D8CD" FontSize="10" />
                <Border Background="#121A24" BorderBrush="#29364A" BorderThickness="1" CornerRadius="5" Padding="7,5">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="7" RowSpacing="3">
                    <TextBlock Text="STUDIO MASTER" Classes="sectionTitle" />
                    <TextBlock x:Name="StudioExportDescriptionText" Grid.Column="1" Text="Broadcast WAV with embedded measurements" Foreground="#67798E" FontSize="9" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="File" Foreground="#8192A7" VerticalAlignment="Center" />
                    <ComboBox x:Name="StudioContainerBox" Grid.Row="1" Grid.Column="1" SelectionChanged="OnStudioExportSelectionChanged" />
                    <TextBlock Grid.Row="2" Text="Encoding" Foreground="#8192A7" VerticalAlignment="Center" />
                    <ComboBox x:Name="StudioEncodingBox" Grid.Row="2" Grid.Column="1" SelectionChanged="OnStudioExportSelectionChanged" />
                    <TextBlock Grid.Row="3" Text="Dither" Foreground="#8192A7" VerticalAlignment="Center" />
                    <ComboBox x:Name="StudioDitherBox" Grid.Row="3" Grid.Column="1" SelectionChanged="OnStudioExportSelectionChanged" ToolTip.Tip="TPDF adds a tiny, repeatable noise floor when reducing audio to integer precision. Float and lossy exports do not use PCM dither." />
                  </Grid>
                </Border>
                <TextBlock x:Name="ReceiverMasterMetricsText" Text="Export measures LUFS and true peak; it never auto-normalizes." TextWrapping="Wrap" Foreground="#8C9EB2" FontSize="9" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                  <Button x:Name="ReceiverMasterHearButton" Content="▶ Master" IsEnabled="False" Click="OnHearReceiverMasterClicked" />
                  <Button x:Name="ReceiverMasterRenderButton" Grid.Column="1" Content="⇥ Studio export" IsEnabled="False" Background="#353056" Foreground="#DED7FA" Click="OnRenderReceiverMasterClicked" ToolTip.Tip="Writes the chosen studio container plus a SHA-256 receipt. No normalization is applied." />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="panel" Margin="8,0" Padding="9">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="STEREO TAKE ARRANGEMENT" Classes="sectionTitle" />
                <TextBlock x:Name="ReceiverTimelineSummaryText" Grid.Column="1" Text="0.000 s" Foreground="#71839A" FontSize="9" />
              </Grid>
              <local:ReceiverTakeTimelineView x:Name="ReceiverTakeTimeline" Grid.Row="1" Margin="0,7" />
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBlock Text="0 s" Foreground="#617286" FontSize="9" />
                <TextBlock x:Name="ReceiverTimelineEndText" Grid.Column="1" Text="0 s" Foreground="#617286" FontSize="9" />
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Column="2" Classes="panel" Padding="10,7">
            <StackPanel Spacing="3">
              <TextBlock Classes="sectionTitle" Text="SELECTED TAKE" />
              <TextBlock x:Name="ReceiverTakeNameText" Text="Choose a recorded take" Foreground="#E5EDF2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ReceiverTakeDetailsText" Text="Channel and timing details appear here." Foreground="#71839A" FontSize="9" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="5">
                <TextBlock Text="Use in master" Foreground="#8192A7" VerticalAlignment="Center" />
                <CheckBox x:Name="ReceiverTakeIncluded" Grid.Column="1" IsEnabled="False" />
                <TextBlock Grid.Column="2" Text="Link L/R" Foreground="#8192A7" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <CheckBox x:Name="ReceiverTakeLinked" Grid.Column="3" IsEnabled="False" Checked="OnReceiverTakeLinkedChanged" Unchecked="OnReceiverTakeLinkedChanged" />
              </Grid>
              <Grid ColumnDefinitions="22,Auto,*,62" RowDefinitions="Auto,Auto" ColumnSpacing="5" RowSpacing="3">
                <TextBlock Text="L" Foreground="#58D8CB" FontWeight="Bold" VerticalAlignment="Center" />
                <CheckBox x:Name="ReceiverTakeLeftMuted" Grid.Column="1" Content="Mute" IsEnabled="False" />
                <TextBlock Grid.Column="2" Text="Gain (0–4)" Foreground="#8192A7" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBox x:Name="ReceiverTakeLeftGain" Grid.Column="3" Text="1.0" IsEnabled="False" HorizontalContentAlignment="Right" />
                <TextBlock Grid.Row="1" Text="R" Foreground="#9A8FD3" FontWeight="Bold" VerticalAlignment="Center" />
                <CheckBox x:Name="ReceiverTakeRightMuted" Grid.Row="1" Grid.Column="1" Content="Mute" IsEnabled="False" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Gain (0–4)" Foreground="#8192A7" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBox x:Name="ReceiverTakeRightGain" Grid.Row="1" Grid.Column="3" Text="1.0" IsEnabled="False" HorizontalContentAlignment="Right" />
              </Grid>
              <Grid ColumnDefinitions="*,70,*,70,*,70" ColumnSpacing="4">
                <TextBlock Text="Start" Foreground="#8192A7" VerticalAlignment="Center" />
                <TextBox x:Name="ReceiverTakeOffset" Grid.Column="1" Text="0" IsEnabled="False" HorizontalContentAlignment="Right" ToolTip.Tip="Places this take on the master timeline, in seconds." />
                <TextBlock Grid.Column="2" Text="In" Foreground="#8192A7" VerticalAlignment="Center" />
                <TextBox x:Name="ReceiverTakeTrimStart" Grid.Column="3" Text="0" IsEnabled="False" HorizontalContentAlignment="Right" ToolTip.Tip="Skips audio before this point in the recorded take." />
                <TextBlock Grid.Column="4" Text="Out" Foreground="#8192A7" VerticalAlignment="Center" />
                <TextBox x:Name="ReceiverTakeTrimEnd" Grid.Column="5" Text="" IsEnabled="False" Watermark="full" HorizontalContentAlignment="Right" ToolTip.Tip="Stops using audio at this point; leave blank for the full take." />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Button x:Name="ReceiverTakeApplyButton" Content="Apply" IsEnabled="False" Background="#266A64" Foreground="White" Click="OnApplyReceiverTakeClicked" />
                <Button x:Name="ReceiverTakeRevertButton" Grid.Column="1" Content="Revert" IsEnabled="False" Click="OnRevertReceiverTakeClicked" />
                <Button x:Name="ReceiverTakeExportChannelsButton" Grid.Column="2" Content="Export L/R" IsEnabled="False" Click="OnExportReceiverChannelsClicked" />
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Button x:Name="ReceiverTakeHearButton" Content="▶ Stereo" IsEnabled="False" Click="OnHearReceiverTakeClicked" />
                <Button x:Name="ReceiverTakeHearLeftButton" Grid.Column="1" Content="▶ Left" IsEnabled="False" Click="OnHearReceiverTakeLeftClicked" ToolTip.Tip="Centers the isolated left channel for inspection." />
                <Button x:Name="ReceiverTakeHearRightButton" Grid.Column="2" Content="▶ Right" IsEnabled="False" Click="OnHearReceiverTakeRightClicked" ToolTip.Tip="Centers the isolated right channel for inspection." />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
